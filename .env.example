# Copy to .env and fill in. Every variable is optional except ANTHROPIC_API_KEY
# (needed for the real writer; the mock backend runs without it).

# --- Claude API -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the squawk writer. Any current Claude model id works.
SQUAWK_MODEL=claude-opus-5-5
# Effort level for the writer call: low | medium | high | xhigh | max
SQUAWK_EFFORT=medium
# Writer backend:
#   anthropic  - Claude API with ANTHROPIC_API_KEY (default)
#   claude-cli - runs the `claude` command (Claude Code) on your subscription; no key needed
#   mock       - deterministic, free, for tests/demos
SQUAWK_WRITER_BACKEND=anthropic
# Command for the claude-cli backend (full path if it is not on PATH, e.g. /opt/homebrew/bin/claude)
SQUAWK_CLAUDE_CLI=claude
# Server-side refusal fallbacks (Claude API only): default | off
SQUAWK_FALLBACKS=default

# --- Cadence ----------------------------------------------------------------
# Seconds between writer passes in normal mode and in event mode.
SQUAWK_WRITE_INTERVAL=300
SQUAWK_EVENT_MODE_INTERVAL=60
# How long event mode stays on after a trigger (seconds).
SQUAWK_EVENT_MODE_DURATION=1800

# --- Sources ----------------------------------------------------------------
SQUAWK_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
SQUAWK_BSKY_API=https://api.bsky.app
SQUAWK_ACCOUNTS_FILE=config/accounts.yaml
# On the first poll, only ingest posts newer than this many hours.
SQUAWK_POLL_BACKFILL_HOURS=6

# --- Market data ------------------------------------------------------------
# mock | dotted path to your MarketSource implementation, e.g. mypkg.feeds:PwlbTodayMarketSource
SQUAWK_MARKET_SOURCE=mock
SQUAWK_MARKET_POLL_INTERVAL=60
# Threshold detection: tenor=bp pairs; window in minutes.
SQUAWK_MARKET_THRESHOLDS=gilt_10y=5,gilt_2y=5,gilt_30y=5
SQUAWK_MARKET_WINDOW_MINUTES=15

# --- Storage / outputs ------------------------------------------------------
SQUAWK_DB_PATH=data/squawk.sqlite
SQUAWK_OUTPUT_DIR=data
SQUAWK_PROMPT_FILE=prompts/squawk_writer.md
SQUAWK_LOG_LEVEL=INFO
